/* Limpa historico de inputs no Maxima */
kill(all);

/* Carrega o módulo Grobner */
load("grobner");

/* Define a ordem monomial para bases de Grobner */
poly_monomial_order:lex;

/* Funções auxiliares para obter o grau e a multiplicidade
    de polinômios
*/
grau(f,x):=hipow(f,x);
multiplicidade(f):=block(
    if (atom(f)) then return(1)
    else return (part(f,2))
);

/* Calcula a divisão entre dois polinômios f,g */
PolyDivide(f,g):=block(
    [F,G,d,q,r],
    F:f,G:g,
    d:divide(F,G),
    q:d[1], r:d[2],
    return([q,r])
)$

/* Algoritmo de Euclides para cálculo do GCD
    entre dois polinômios a,b de entrada
    Saída: gcd(a,b) in Q[x]
*/
Euclidean(a,b):=
    block([A,B,q,r,d],
    A:a, B:b,
    while (B # 0) do (
        [q,r]:PolyDivide(A,B),
        A:B, B:r
    ),
    return(A)
)$

/*  Calcula o algoritmo Euclideano estendido para
    polinômios a,b in Q[x]. Isto é, calcula os coeficientes
    s,t tais que:
        sa + tb = gcd(a,b,)
    Entrada: polinômios a,b
    Saída: Lista [s, t, gcd(a,b)]
*/
ExtendedEuclidean(a,b):=block(
    [A,B,a1,a2,b1,b2,q,r,r1,r2],
    A:a, B:b,
    a1:1, a2:0,
    b1:0, b2:1,
    while (B # 0) do (
        [q,r]:PolyDivide(A,B),
        A:B, B:r,
        r1:a1-q*b1,  r2:a2-q*b2,
        a1:b1, a2:b2, b1:r1, b2: r2
        /*
        print(" a1: ", expand(a1), " a2: ", expand(a2),
        " b1: ", expand(b1), " b2: ", expand(b2))
        */
    ),
    return([expand(a1),expand(a2),expand(A)])
)$

/* Versão Diofantina do algoritmo Euclideano estendido
    Entrada: polinômios a,b,c
    Saída: Lista [s,t] tal que
        s*a + tb = c e ou s = 0 ou grau(s) < grau(b)
*/
DioExtendedEuclidean(a,b,c):=block(
    [A,B,C,s,t,g,q,r],
    A:a, B:b, C:c,
    [s,t,g]:ExtendedEuclidean(A,B),
    [q,r]:PolyDivide(C,g),
    if (r # 0) then
        print("c is not in the ideal generated by a and b"),
    s:q*s, t:q*t,
    if (s # 0 and grau(s,x) >= grau(B,x)) then (
        [q,r]:PolyDivide(s,B),
        s:r, t:t+q*A
    ),
    return([expand(s),expand(t)])
)$

/* Calcula o conteúdo e a parte primitiva de
    um polinômio A
*/
conteudo(A):=content(A,x)[1];
primitive_part(A):=content(A)[2];

/* Funções para calcular e manipular
   a fatoração livre de quadrados de um
   dado polinômio f dado como entrada
*/
fatoracao_livreQuadrados(f):=sqfr(f);
lfatores_livresQuadrados(f):=args(sqfr(f));

getMax_multiplicidade(lpoly):=block(
	[maxm],
	maxm:multiplicidade(lpoly[1]),
	for i:1 thru length(lpoly) do (
		mtmp:multiplicidade(lpoly[i]),
		if (mtmp > maxm) then
			maxm:mtmp
	),
	return(maxm)
);
GetFator_semMultiplicidade(f):=part(f,1);
getFator_multiplicidade(lpoly,j):=block(
	[FIND],	FIND:0,
	for i:1 thru length(lpoly) do (
		if is(multiplicidade(lpoly[i]) = j) then FIND:i
	),
	if is(FIND=0) then return(1)
	else return(GetFator_semMultiplicidade(lpoly[FIND]))
);

/* Versão quadrática do algoritmo de Hermite
    Entrada: Função racional f = A/D
    Saída: Lista [g, A/D] onde
        g: Primitiva da parte racional (ou algébrica) da integral de f
        A/D: Função racional cujo denominador D é livre
        de quadrados e cuja integral é transcendental
        (logarítmica)
*/
hermite_reduce(f,x):=block(
    [A,D,g,L,m,i,V,U,j,dV,B,C,dB],
    A:num(f),D:denom(f),
    g:0, L:lfatores_livresQuadrados(D),
    m:getMax_multiplicidade(L),

    for i:2 thru m do (
        if (grau(getFator_multiplicidade(L,i),x) > 0) then (
            V:getFator_multiplicidade(L,i),
            U:D/(V^i),
            for j:(i-1) thru 1 step -1 do (
                dV:diff(V,x),
                [B,C]:DioExtendedEuclidean(U*dV,V,-A/j),
                g:g+(B/V^j),
                dB:diff(B,x),
                A:-j*C-U*dB
            )
        ),
            D:U*V
        ),
    return([g,fullratsimp(expand(A/D))])
);

/* Alias para hermite_reduce */
hermite(f,x):=block(
    if (sqfr(denom(f)) = denom(f)) then (
        print("Denominador já livre de quadrados, não
        dá pra reduzir mais - chamando czichowski(f,x) e
        cziToLog..."),
        C:czichowski(f,x),
        cziToLog(C[1],C[2])
    )
    else hermite_reduce(f,x)
);

/* Algoritmo de czichowski para calcular a
   primitiva transcendental (logarítmica) da
   função racional f.

   Entrada: Uma função racional f = A/D onde
        grau(A) < grau(D) e D é livre de quadrados
   Saída: Uma lista [L, Ls] tal que
        L: Lista de raizes (coeficientes constantes
        complexas) de cada termo logarítmico do
        somatório.
        Ls : Lista de polinômios S(x,t) in C[x]
        que ocorrem no logaritmando de cada logarítmico
        do somatório.
*/
czichowski(f,x):=block(
    [A,D,P,m,dD,t,Qi,Si,L,Ls],
    A:num(f),D:denom(f),
    dD:diff(D,x),
    P:poly_reduced_grobner([D,A-t*dD],[x,t]),
    P:reverse(P), /* [OLHAR] Aqui tem que trocar por sortPoly
    para ordenar de forma crescente o conjunto P */
    m:length(P),
    L:[], Ls:[],
    for i:1 thru m-1 do (
        Qi:conteudo(P[i])/conteudo(P[i+1]),
        Si:primitive_part(P[i+1]),
        L:append(L,solve(Qi=0)),
        Ls:append(Ls,[expand(Si/coeff(Si,x))])
    ),
   return([L,Ls])
);

/* Função auxiliar ao método de czichowski para construir
   a soma logarítmica, que esse método deve retornar.
    Entrada: Duas listas Lroots, Lpoly (saídas de czichowski)
    Saída: Uma soma de termos logarítmicos montados a partir
   dessas listas.
*/
cziToLog(Lroots,Lpoly):=block(
    [i,j, poly, root, logaritmando, logaritmo, L],
    if (length(Lroots) = 0 or length(Lpoly) = 0) then return(0),
    for i:1 thru length(Lpoly) do (
        poly:Lpoly[i],
        L:[],
        for j:1 thru length(Lroots) do (
            root:Lroots[j],
            if (atom(poly)) then logaritmando:ev(poly,t:root)
            else if (ev(poly,t:root) = poly) then logaritmando:poly
            else logaritmando:args(ev(poly,t:root))[2],
            logaritmo:args(root*log(logaritmando))[2],
            L:append(L, [logaritmo])
        )
    ),
    return( sum( L[i],i,1,length(L)))
);



